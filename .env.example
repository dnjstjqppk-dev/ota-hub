# ==============================================================================
# getfortrip Global OTA Platform - Master Environment Variables
# ==============================================================================
# Worker 프로덕션 시크릿은 이 파일이 아니라 `wrangler secret put <KEY>`로 등록한다.
# 로컬 개발은 wrangler.local.jsonc + .dev.vars(깃 제외)를 사용한다.

# --- Cloudflare Worker (worker/src/env.ts) ---
#필수. 32자 이상. 미만이면 /health는 503(degraded).
JWT_SECRET=change-me-to-a-32-plus-char-random-secret
#필수. 32바이트 base64. 여권번호 AES-GCM 암호화. 없으면 여권 포함 예약이 503.
PII_ENC_KEY=change-me-32-byte-base64-key-------------
# production | staging | development | test. development/test가 아니면 전부 production 취급.
APP_ENV=development
# 공개값. wrangler.jsonc vars와 동일하게 유지.
ALLOWED_ORIGINS=https://getfortrip.com,https://admin.getfortrip.com,https://partner.getfortrip.com,https://ota-hub.dnjstjqppk.workers.dev,http://localhost:3000,http://localhost:3001,http://localhost:3002
PUBLIC_SITE_URL=https://getfortrip.com

# --- 결제 (Toss Payments). 미설정 시 결제는 비활성으로 정직 응답. ---
# "toss" | "sandbox"(development/test 전용) | 미설정=비활성
PAYMENT_PROVIDER=sandbox
# live_... = 실결제, test_... = 토스 샌드박스
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
# 토스 계약 검증용 스텁 주소(development/test 전용, 예: http://127.0.0.1:PORT). 프로덕션에서는 무시.
TOSS_API_BASE=

# --- 공급사/판매주체 플래그 (development/test에서만 "true" 허용) ---
ALLOW_SIMULATED_SUPPLIERS=true
ALLOW_DRAFT_ENTITY=true

# --- 메일 (Resend). 미설정 시 outbox 적재 + API가 NOT_CONFIGURED로 응답. ---
RESEND_API_KEY=
EMAIL_FROM=getfortrip <noreply@getfortrip.com>

# --- 오류 리포팅 (Sentry). 미설정 시 리포터는 조용히 비활성. ---
# 워커: wrangler secret put SENTRY_DSN (프로덕션). 로컬은 .dev.vars에 추가.
SENTRY_DSN=
# 릴리스 태그: 배포 스크립트가 git sha로 자동 주입. 비우면 태그 생략.
SENTRY_RELEASE=
# 프론트 3종은 빌드 시점에 주입. CI는 GitHub Secret SENTRY_DSN을 사용.
NUXT_PUBLIC_SENTRY_DSN=
VITE_SENTRY_DSN=
# 포털 릴리스 태그: CI가 github.sha로 자동 주입.
NUXT_PUBLIC_SENTRY_RELEASE=
VITE_SENTRY_RELEASE=

# --- User Web Frontend (Nuxt 3) ---
NUXT_PUBLIC_API_BASE=/api/v1

# --- Admin Console Frontend (Vue 3 + Vite) ---
VITE_API_BASE_URL=/api/v1

# --- Partner Extranet Frontend (Vue 3 + Vite) ---
# (미설정 시 localhost는 :8787, 그 외는 ota-hub로 폴백)

# --- Go 참조 백엔드 (backend/, 인메모리·배포 대상 아님) ---
PORT=8080
