# ==============================================================================
# Trip.com Production Clone - Master Environment Variables
# ==============================================================================

# Backend Go API Server Configuration
PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/tripdb?sslmode=disable
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=https://tripclone.com,https://admin.tripclone.com,http://localhost:3000,http://localhost:3001
PUBLIC_SITE_URL=https://tripclone.com

# User Web Frontend (Nuxt 3)
NUXT_PUBLIC_API_BASE=https://api.tripclone.com/api/v1

# Admin Console Frontend (Vue 3 + Vite)
VITE_API_BASE_URL=https://api.tripclone.com/api/v1
