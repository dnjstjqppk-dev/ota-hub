{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ota-hub",
  "main": "worker/index.ts",
  "compatibility_date": "2024-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ota_production",
      "database_id": "d36231d8-4bfb-42e1-ae51-a019723e5db0"
    }
  ],
  "assets": {
    "directory": "frontend-user/.output/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "JWT_SECRET": "47ab072289de6845c7336403b693e8bee13baa28ad7020e56c703386c101f650",
    "AFFILIATE_HMAC_SECRET": "7069045ddc627aa2cb6573fdbbee49e593f2e53c90f71866e5db38fa7f04bb77"
  }
}
