{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ota-hub",
  "main": "worker/index.ts",
  "compatibility_date": "2024-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "node scripts/build-all.js"
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ota_production",
      "database_id": "d36231d8-4bfb-42e1-ae51-a019723e5db0",
      "migrations_dir": "worker/migrations"
    }
  ],
  "assets": {
    "directory": "frontend-user/.output/public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://getfortrip.com,https://www.getfortrip.com,https://admin.getfortrip.com,https://partner.getfortrip.com,https://ota-hub.dnjstjqppk.workers.dev,https://ota-admin.dnjstjqppk.workers.dev,https://ota-partner.dnjstjqppk.workers.dev,http://localhost:3000,http://localhost:3001,http://localhost:3002",
    "PUBLIC_SITE_URL": "https://getfortrip.com",
    "PARTNER_SITE_URL": "https://ota-partner.dnjstjqppk.workers.dev"
  }
}
