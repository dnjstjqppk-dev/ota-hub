{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ota-hub",
  "compatibility_date": "2024-10-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "frontend-user/.output/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": false
  }
}
