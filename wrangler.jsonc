{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ota-hub",
  "main": "worker/index.ts",
  "compatibility_date": "2024-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "node scripts/build-all.js"
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ota_production",
      "database_id": "d36231d8-4bfb-42e1-ae51-a019723e5db0",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "getfortrip-uploads" }
  ],
  "assets": {
    "directory": "frontend-user/.output/public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://getfortrip.com,https://www.getfortrip.com,https://admin.getfortrip.com,https://partner.getfortrip.com,https://ota-hub.dnjstjqppk.workers.dev,https://ota-admin.dnjstjqppk.workers.dev,https://ota-partner.dnjstjqppk.workers.dev",
    "PUBLIC_SITE_URL": "https://getfortrip.com",
    "PARTNER_SITE_URL": "https://ota-partner.dnjstjqppk.workers.dev",
    // Declared provider with no key yet: /health stays DISABLED until TOSS_SECRET_KEY
    // is registered (docs/GO_LIVE_CHECKLIST.md step 6). TOSS_CLIENT_KEY and
    // EMAIL_FROM stay unset until their real values exist — no placeholders.
    "PAYMENT_PROVIDER": "toss"
  },
  // TG-08: staging mirrors production safety (no sandbox provider, no draft
  // entity, no simulated suppliers — APP_ENV=staging counts as production).
  // Hub only; admin/partner consoles ride the hub /admin/ + /partner/ fallbacks.
  "env": {
    "staging": {
      "name": "ota-hub-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ota_staging",
          "database_id": "56accb00-19fb-47ad-bc0e-9a2e456adda5",
          "migrations_dir": "worker/migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "getfortrip-uploads-staging" }
      ],
      "vars": {
        "APP_ENV": "staging",
        "ALLOWED_ORIGINS": "https://ota-hub-staging.dnjstjqppk.workers.dev",
        "PUBLIC_SITE_URL": "https://ota-hub-staging.dnjstjqppk.workers.dev",
        "PARTNER_SITE_URL": "https://ota-hub-staging.dnjstjqppk.workers.dev/partner/"
      }
    }
  }
}
