{
  "name": "getfortrip-platform",
  "version": "1.0.1",
  "private": true,
  "description": "getfortrip Global OTA Platform (Nuxt 3 SPA + Vue 3 Admin + Go API)",
  "workspaces": [
    "frontend-user",
    "frontend-admin"
  ],
  "scripts": {
    "build": "node scripts/build-all.js",
    "build:user": "npm --prefix frontend-user run generate",
    "build:admin": "npm --prefix frontend-admin run build",
    "check:branding": "node scripts/check-branding.js",
    "build:all": "node scripts/build-all.js",
    "deploy": "node scripts/build-and-deploy.js"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
