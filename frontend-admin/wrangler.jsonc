{
  "name": "ota-admin",
  "compatibility_date": "2024-10-12",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "routes": [{ "pattern": "admin.getfortrip.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": false
  }
}
