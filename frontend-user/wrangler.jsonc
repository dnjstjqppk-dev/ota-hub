{
  // TG-15: user portal SSR worker (Nitro cloudflare-module preset + ISR). Serves the
  // apex (getfortrip.com); /api/* stays on ota-hub via Cloudflare Routes.
  // Local: `nuxt dev` (:3000) against the hub API, or `wrangler dev` here.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ota-user",
  // 2026-11-25: moved to the account that owns the getfortrip.com zone (custom
  // domains/routes require same-account). account_id beats CLOUDFLARE_ACCOUNT_ID.
  "account_id": "f5c363135efe9b22ca66eb39f2f8e1da",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2024-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Country-subdomain routing (2026-11-27): apex + www + regional subdomains.
  // Edge redirects (legacy /en|/ja|/zh 301 & Geo-IP 302) live in edge/edge-guard.mjs.
  "workers_dev": true,
  "routes": [
    { "pattern": "getfortrip.com", "custom_domain": true },
    { "pattern": "www.getfortrip.com", "custom_domain": true },
    { "pattern": "kr.getfortrip.com", "custom_domain": true },
    { "pattern": "jp.getfortrip.com", "custom_domain": true },
    { "pattern": "uk.getfortrip.com", "custom_domain": true },
    { "pattern": "hk.getfortrip.com", "custom_domain": true },
    { "pattern": "tw.getfortrip.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  // P0-1 (2026-11-22 audit): SSR must NOT fetch the hub over workers.dev
  // (Error 1042). 00.hub-binding.server.ts forwards those calls here.
  "services": [{ "binding": "API", "service": "ota-hub" }],
  "vars": {
    // Browser API calls go to the apex /api/* route (same-origin on the apex,
    // CORS-allowed from the workers.dev preview). SSR keeps the service binding.
    "NUXT_PUBLIC_API_BASE": "https://getfortrip.com/api/v1",
    "NUXT_API_BASE_SERVER": "https://ota-hub.dnjstjq0824.workers.dev/api/v1"
  }
}
