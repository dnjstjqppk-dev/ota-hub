# backend/.env.example — every variable the Go service actually reads (os.Getenv).
# Copy to backend/.env for local runs. The worker (Cloudflare) does NOT read this file.
PORT=8080
JWT_SECRET=replace-with-32-plus-char-secret
ADMIN_PASSWORD=
GO_PARTNER_PASSWORD=
ALLOWED_ORIGINS=https://getfortrip.com,https://admin.getfortrip.com,https://ota-hub.dnjstjqppk.workers.dev,http://localhost:3000,http://localhost:3001
# Optional AI/curation helpers (empty = disabled).
# #123: POST /api/v1/webhook/ingest + /curated/products/{id}/sync-webhook are
# admin-JWT only. Each call burns one Gemini rewrite (billed per token when a
# key is set; rule-based synthesis otherwise) and mints referral URLs with the
# affiliate IDs below (development defaults apply when unset).
GEMINI_API_KEY=
GEMINI_MODEL=
AGODA_PARTNER_CID=
TRIPCOM_ALLIANCE_ID=
KLOOK_AFFILIATE_AID=
KKDAY_CAMPAIGN_CID=
MYREALTRIP_PARTNER_ID=
TRAVEL_CHECKIN_API_KEY=
TRAVEL_CHECKIN_WEBHOOK_URL=
