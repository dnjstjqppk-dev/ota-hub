#!/bin/sh
# ==============================================================================
# getfortrip Global OTA Platform - Post-Commit Hook (safe default)
# ==============================================================================
# Deploys to production ONLY on explicit DEPLOY=1. Plain commits never touch
# production (2026-11-14: the previous auto-deploy default shipped an unapproved
# production migration+deploy from an agent commit — TG-02 inverted the default).
#
#   git commit                                    # no production touch, always safe
#   DRY_RUN=1 node scripts/build-and-deploy.js   # rehearse (no side effects)
#   node scripts/build-and-deploy.js              # real deploy (user only)

# Explicit skip wins even over DEPLOY=1 (belt and suspenders).
if [ "$SKIP_DEPLOY" = "1" ]; then
    echo "⏩ [Post-commit] SKIP_DEPLOY=1 — skipping Cloudflare rebuild."
    exit 0
fi

if [ "$DEPLOY" = "1" ]; then
    echo "🚀 [Post-commit] DEPLOY=1 — running Cloudflare rebuild & deployment..."
    node scripts/build-and-deploy.js
    exit $?
fi

echo "⏩ [Post-commit] production deploy skipped (default). To deploy, run:"
echo "   DRY_RUN=1 node scripts/build-and-deploy.js   # rehearse, no side effects"
echo "   node scripts/build-and-deploy.js              # real deploy (user only)"
exit 0
