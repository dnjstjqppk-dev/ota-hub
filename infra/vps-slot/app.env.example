# Slot app env — copy /srv/getfortrip/.env.slot values below, then add the extras.
# This file lives at /srv/getfortrip/app/.env on the VPS (never commit it).

# --- from /srv/getfortrip/.env.slot (copy verbatim) ---
PORT=9103
DATABASE_URL=postgres://getfortrip:<slot-password>@127.0.0.1:5432/getfortrip_dev
# DB index 2 ONLY (0/1/3/4 belong to other projects). Password only if set.
REDIS_URL=redis://127.0.0.1:6379/2

# --- extras (generate once, keep) ---
# Long random strings: openssl rand -base64 32
# Without these the server mints per-boot secrets and logins break on restart.
JWT_SECRET=change-me-32-plus-chars
PII_ENC_KEY=change-me-32-byte-base64
PUBLIC_SITE_URL=http://getfortrip.13.140.250.138.nip.io
E2E_UPLOADS_DIR=/srv/getfortrip/data/uploads
